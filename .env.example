# ==============================================================================
# GymTracker Cloud Environment Configuration
# ==============================================================================

# 4-Digit Security PIN for phone access (Default: 1208)
# Change this to any 4 digits you prefer
GYM_APP_PIN=1208

# Flask Session Security Key
# In production, use a long random string (e.g., openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_string_in_cloud_deployment

# Cloud PostgreSQL Database URI
# Automatically populated by Render/Railway blueprints, or enter your Supabase/Neon URI.
# If omitted or empty, GymTracker automatically uses local sqlite:///gym.db
DATABASE_URL=

# ntfy.sh background rest alert topic (subscribe to this in the free ntfy mobile app)
NTFY_TOPIC=gym-rest-alerts-9988

# Flask Environment (development | production)
FLASK_ENV=production
